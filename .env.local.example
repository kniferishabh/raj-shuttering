# ── Supabase PostgreSQL ──────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
#
# For Vercel (runtime — use "Transaction" pooler, port 6543):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# For migrations / db:push / db:seed (use "Direct" connection, port 5432):
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── NextAuth (required on Vercel) ────────────────────────────────────
NEXTAUTH_SECRET=your-32-char-secret-here-change-me
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Admin login (required on Vercel) ─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rajshuttering@2024

# ── App URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
